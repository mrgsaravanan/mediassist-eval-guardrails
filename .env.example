# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai            # openai | bedrock
OPENAI_API_KEY=
OPENAI_BASE_URL=               # optional: any OpenAI-compatible endpoint
AWS_REGION=us-east-1           # only when LLM_PROVIDER=bedrock (uses standard AWS credential chain)

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mediassist-eval-guardrails
