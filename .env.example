# Copy to .env and fill in. Never commit .env.
# Keep comments on their own line: an empty value followed by an inline comment is parsed as the comment.

# openai | bedrock | claude_cli   (claude_cli = your Claude subscription via the logged-in `claude` CLI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (must start with http:// or https://)
OPENAI_BASE_URL=
# Only when LLM_PROVIDER=bedrock (uses the standard AWS credential chain)
AWS_REGION=us-east-1

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mediassist-eval-guardrails
